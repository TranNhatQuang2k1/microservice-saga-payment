NX_NO_CLOUD=true yarn nx serve api-gateway --no-tui
# hoặc tắt check version
NX_DISABLE_LATEST_NX_VERSION_CHECK=true yarn nx serve api-gateway --no-tui

# Cấu hình cho Primary (Trỏ tới PgBouncer Primary ở port 6432)
DB_TYPE=postgres
DB_SCHEME=postgres
DB_HOST=127.0.0.1
DB_PORT=6432
DB_USERNAME=convoy_user
DB_PASSWORD=convoy_pass
DB_DATABASE=convoy
DB_OPTIONS=sslmode=disable&connect_timeout=30

# Giới hạn connection phía Fastify xuống thấp vì PgBouncer đã lo xếp hàng rồi
DB_MAX_OPEN_CONN=10
DB_MAX_IDLE_CONN=2
DB_CONN_MAX_LIFETIME=3600

# Cấu hình mảng JSON cho Read Replicas (Trỏ tới PgBouncer Replica ở port 6433)
# Hãy đảm bảo JSON này hợp lệ (viết liền trên 1 dòng để file .env không bị lỗi)
DB_READ_REPLICAS=[{"host":"127.0.0.1","port":6433,"username":"convoy_user","password":"convoy_pass","database":"convoy","maxOpenConn":10,"maxIdleConn":2}]
CACHE_BACKEND = memory